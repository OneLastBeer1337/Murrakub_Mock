  %% ===== Concepts (middle) =====
  subgraph Concepts[" Concepts / Mechanisms "]
    C_DAG{{"DAG / Topological-order workflow execution"}}
    C_PGO{{"Profile-Guided Optimization (real measured data drives allocation)"}}
    C_MILP{{"MILP joint solver for task/model/hardware assignment"}}
    C_HEURISTIC{{"Heuristic/greedy allocation as MILP alternative"}}
    C_DRIFT{{"Self-updating / drift-correcting profile estimates"}}
    C_STATIC_DYNAMIC{{"Static (design-time) vs dynamic (runtime-adaptive) allocation"}}
    C_FORMAL_OBJ{{"Formal cost/latency/quality objective function"}}
    C_EVAL_METRICS{{"Evaluation metrics for allocation/routing quality"}}
    C_FEASFIRST{{"Feasibility-first filtering before cost-ranking"}}
    C_LEARNED_ROUTING{{"Learned query-to-model routing"}}
    C_QUALITY_COST_METRIC{{"Quality-vs-cost tradeoff metrics (PGR/APGR-style)"}}
    C_ONLINE_PREF_EVAL{{"Online preference-based evaluation methodology"}}
    C_CURVE_METRICS{{"Curve-level routing metrics (nAUC, Peak Score, QNC, RCI)"}}
    C_STANDARDIZED_TOOLING{{"Standardized-tooling design pattern for fair comparison harness"}}
    C_COMBO_SELECTION{{"Model-combination-level selection (assign models per pipeline role jointly, not per call)"}}
    C_BANDIT_SEARCH{{"Multi-armed bandit / arm-elimination search over a combinatorial config space"}}
    C_CLIENT_SIDE_OPT{{"Client-side (developer-controlled) optimization vs server-side serving optimization"}}
    C_TRANSPORT_INTERCEPT{{"Framework-agnostic transport-layer interception/attribution for measuring per-call cost/latency"}}
    C_MARL_ALLOC{{"Multi-agent RL for decentralized task-to-resource allocation (learned policies vs. rule-based/heuristic assignment)"}}
    C_DECPOMDP{{"Dec-POMDP: decentralized execution under partial observability, each resource/task-executor modeled as an autonomous agent"}}
    C_BASELINE_STATTEST{{"Baseline-comparison evaluation methodology (random / best-heuristic / ground-truth baselines + non-parametric significance testing)"}}
    C_CTDE{{"Centralized Training with Decentralized Execution (CTDE) as the dominant MARL training/execution paradigm"}}
    C_MARL_CHALLENGES{{"Named MARL failure modes: non-stationarity, partial observability, credit assignment, scalability, communication constraints"}}
    C_UPDATE_OPACITY{{"Update opacity: inability to explain why a model's output changed between versions, even when each version's individual reasoning is otherwise understood"}}
    C_INTRA_ML_DISAGREEMENT{{"Intra-ML disagreement / diachronic evolution: a system giving different outputs for functionally identical inputs before vs. after an update or drift-correction"}}
    C_LOGICAL_PHYSICAL_SPLIT{{"Logical plan / physical plan separation: structure decisions and implementation decisions optimized as two distinct but jointly-searched layers"}}
    C_SAFE_REWRITE_RULES{{"Correctness-preserving structural rewrite rules (reordering, splitting/merging) applied only where declared local dependency facts permit them"}}
    C_SENTINEL_SAMPLING{{"Sentinel plans: cheap, sample-based estimation using a few reference configurations to compare candidates before committing to full evaluation"}}
    C_LLM_REWRITE_AGENT{{"LLM-driven (agentic) rewrite generation and verification, as opposed to fixed provably-safe rule-based rewriting"}}
    C_DOC_DECOMPOSE_PATTERN{{"Document-processing-specific decomposition patterns (e.g. split-gather-map-reduce for long documents)"}}
  end
